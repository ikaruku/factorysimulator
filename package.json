{
  "name": "factory-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game open world multiplayer bertema factory (Factory Simulator)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @factory-simulator/client --filter @factory-simulator/server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "setup:blender": "node tools/asset-pipeline/ensure-blender.mjs",
    "build:character": "node tools/character-builder/run-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
